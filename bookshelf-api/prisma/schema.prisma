generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
}

enum ReadingStatus {
  WANT_TO_READ
  READING
  READ
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  username     String   @unique
  passwordHash String
  displayName  String?
  bio          String?
  avatarUrl    String?
  role         Role     @default(USER)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  refreshTokens  RefreshToken[]
  ratings        Rating[]
  libraryEntries LibraryEntry[]
  shelves        Shelf[]
  readingGoals   ReadingGoal[]
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Author {
  id             String   @id @default(uuid())
  openLibraryKey String?  @unique
  name           String
  bio            String?
  birthDate      String?
  deathDate      String?
  photoId        Int?
  alternateNames String[] @default([])
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  books BookAuthor[]

  @@index([name])
}

model Book {
  id               String   @id @default(uuid())
  openLibraryKey   String?  @unique
  title            String
  subtitle         String?
  description      String?
  coverId          Int?
  firstPublishYear Int?
  ratingsCount     Int      @default(0)
  ratingSum        Int      @default(0)
  averageRating    Float?
  olRatingsCount   Int?
  olAverageRating  Float?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  authors        BookAuthor[]
  genres         BookGenre[]
  editions       Edition[]
  ratings        Rating[]
  libraryEntries LibraryEntry[]
  shelfBooks     ShelfBook[]

  @@index([title])
  @@index([averageRating])
  @@index([olRatingsCount])
  @@index([firstPublishYear])
}

model BookAuthor {
  bookId   String
  authorId String
  position Int    @default(0)

  book   Book   @relation(fields: [bookId], references: [id], onDelete: Cascade)
  author Author @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@id([bookId, authorId])
  @@index([authorId])
}

model Genre {
  id   String @id @default(uuid())
  name String @unique
  slug String @unique

  books BookGenre[]
}

model BookGenre {
  bookId  String
  genreId String

  book  Book  @relation(fields: [bookId], references: [id], onDelete: Cascade)
  genre Genre @relation(fields: [genreId], references: [id], onDelete: Cascade)

  @@id([bookId, genreId])
  @@index([genreId])
}

model Edition {
  id             String   @id @default(uuid())
  openLibraryKey String?  @unique
  bookId         String
  title          String
  subtitle       String?
  publishers     String[] @default([])
  publishDate    String?
  publishYear    Int?
  pageCount      Int?
  isbn10         String?  @unique
  isbn13         String?  @unique
  languages      String[] @default([])
  physicalFormat String?
  coverId        Int?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  book           Book           @relation(fields: [bookId], references: [id], onDelete: Cascade)
  ratings        Rating[]
  libraryEntries LibraryEntry[]

  @@index([bookId])
}

model Rating {
  id        String   @id @default(uuid())
  userId    String
  bookId    String
  editionId String?
  value     Int
  review    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  book    Book     @relation(fields: [bookId], references: [id], onDelete: Cascade)
  edition Edition? @relation(fields: [editionId], references: [id], onDelete: SetNull)

  @@unique([userId, bookId])
  @@index([bookId, createdAt])
  @@index([userId, createdAt])
}

model LibraryEntry {
  id          String        @id @default(uuid())
  userId      String
  bookId      String
  editionId   String?
  status      ReadingStatus
  startedAt   DateTime?     @db.Date
  finishedAt  DateTime?     @db.Date
  currentPage Int?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  book    Book     @relation(fields: [bookId], references: [id], onDelete: Cascade)
  edition Edition? @relation(fields: [editionId], references: [id], onDelete: SetNull)

  @@unique([userId, bookId])
  @@index([userId, status])
  @@index([userId, finishedAt])
}

model Shelf {
  id          String   @id @default(uuid())
  userId      String
  name        String
  description String?
  isPublic    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user  User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  books ShelfBook[]

  @@unique([userId, name])
}

model ShelfBook {
  shelfId String
  bookId  String
  addedAt DateTime @default(now())

  shelf Shelf @relation(fields: [shelfId], references: [id], onDelete: Cascade)
  book  Book  @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@id([shelfId, bookId])
  @@index([bookId])
}

model ReadingGoal {
  id          String   @id @default(uuid())
  userId      String
  year        Int
  targetBooks Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, year])
}
